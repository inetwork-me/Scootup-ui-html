{% extends "base.twig" %}
{% block content %}
<main id="main" class="max-w-screen-xl mx-auto px-4 py-12" role="main">
  {% if post %}
    <h1 class="font-display text-4xl font-bold mb-6 text-ink">{{ post.title | default('') }}</h1>
    <div class="prose max-w-none">{{ post.content | raw }}</div>
  {% endif %}
</main>
{% endblock %}
