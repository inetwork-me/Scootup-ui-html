{% elseif name == 'arrow-up-right' %}
  <svg class="{{ _cls }}" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M8.6 7H17v8.4" {{ _stroke | raw }}></path></svg>
