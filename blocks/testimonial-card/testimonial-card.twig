{# Testimonial card. Attributes: quote, rating(number), author, role, platform, avatarUrl.
   Star rating renders N stars via the #i-star sprite. #}
{% set _rating = rating | default(5) %}
{% set _author = author | default('') %}
{% set _initials = _author|split(' ')|map(w => w|first)|join|upper|slice(0, 2) %}
<article class="testi-card">
  <div class="testi-top">
    <div class="testi-stars" aria-label="{{ _rating }} out of 5 stars">
      {% for i in 1.._rating %}
        <svg class="testi-star" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path></svg>
      {% endfor %}
    </div>
    {% set _plat = platform | default('instagram') %}
    {% if _plat == 'tiktok' %}
      <svg class="testi-plat-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.1V9.01a6.34 6.34 0 0 0-6.13 6.33 6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.33-6.34V8.69a8.12 8.12 0 0 0 4.77 1.52V6.76a4.85 4.85 0 0 1-1-.07z"></path></svg>
    {% elseif _plat == 'youtube' %}
      <svg class="testi-plat-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.95-1.96C18.88 4 12 4 12 4s-6.88 0-8.59.46a2.78 2.78 0 0 0-1.95 1.96A29 29 0 0 0 1 12a29 29 0 0 0 .46 5.58A2.78 2.78 0 0 0 3.41 19.6C5.12 20 12 20 12 20s6.88 0 8.59-.46a2.78 2.78 0 0 0 1.95-1.96A29 29 0 0 0 23 12a29 29 0 0 0-.46-5.58z"></path><polygon points="9.75 15.02 15.5 12 9.75 8.98 9.75 15.02" fill="white"></polygon></svg>
    {% elseif _plat == 'linkedin' %}
      <svg class="testi-plat-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6z"></path><rect x="2" y="9" width="4" height="12"></rect><circle cx="4" cy="4" r="2"></circle></svg>
    {% else %}
      <svg class="testi-plat-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5"></rect><circle cx="12" cy="12" r="4.3"></circle><circle cx="17.5" cy="6.5" r=".9" fill="currentColor" stroke="none"></circle></svg>
    {% endif %}
  </div>
  <p class="testi-quote">{{ quote | default('') }}</p>
  <div class="testi-author">
    <div class="testi-avatar" aria-hidden="true">{{ _initials | default('') }}</div>
    <div>
      <div class="testi-name">{{ _author }}</div>
      <div class="testi-role">{{ role | default('') }}</div>
    </div>
  </div>
</article>
