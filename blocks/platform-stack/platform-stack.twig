{# scootup/platform-stack — DELIVERABLES section. Mirrors the #deliverables section from reels.html.
   LEFT: eyebrow + heading + body + CTA. RIGHT: fanned platform card stack.
   The .pc / .plat-stack CSS positions, fans and cycles the cards (app.js drives the cycle).
   Brand glyphs are decorative; selected by the `icon` key. #}
{% set _eyebrow = eyebrow | default('Every Platform') %}
{% set _heading = heading | default('One team. Every feed.') %}
{% set _body = body | default("We don't just make videos — we make content that belongs. Every reel is crafted native to its platform, engineered for the algorithm, and built to connect with real people in real seconds.") %}
{% set _cta_label = ctaLabel | default('Start creating reels') %}
{% set _cta_url = ctaUrl | default('/contact') %}
{% set _platforms = platforms | default([
  { name: 'Facebook Reels', icon: 'facebook' },
  { name: 'TikTok', icon: 'tiktok' },
  { name: 'Instagram Reels', icon: 'instagram' },
  { name: 'YouTube Shorts', icon: 'youtube' },
  { name: '@yourbrand', icon: 'scootup' }
]) %}

<section id="deliverables" class="py-24 md:py-36 px-5 md:px-10">
  <div class="mx-auto max-w-[1560px]">
    <div class="plat-grid">

      <!-- LEFT: text -->
      <div>
        {% if _eyebrow %}
          <div data-reveal="tag" class="mb-6"><span class="hero-tag"><span class="hero-tag-text">{{ _eyebrow }}</span></span></div>
        {% endif %}
        <h2 data-reveal="words" class="font-display font-extrabold tracking-[-0.035em] leading-[.92] text-[clamp(2.4rem,5vw,4.8rem)]">
          {{ _heading }}
        </h2>
        {% if _body %}
          <p data-reveal="up" style="--d:.08s" class="text-muted leading-[1.75] text-[1rem] mt-6 max-w-[460px]">{{ _body }}</p>
        {% endif %}
        {% if _cta_label %}
          <a href="{{ _cta_url }}" class="rh-btn-primary flip-btn mt-9" data-reveal="up" style="--d:.16s">
            <span class="flip-3d">
              <span class="flip-face flip-face--a">{{ _cta_label }} <svg class="ico" viewBox="0 0 24 24" aria-hidden="true" style="stroke:currentColor;fill:none;stroke-width:2;stroke-linecap:round;"><path d="M7 17 17 7M8.6 7H17v8.4"/></svg></span>
              <span class="flip-face flip-face--b">Let's talk <svg class="ico" viewBox="0 0 24 24" aria-hidden="true" style="stroke:currentColor;fill:none;stroke-width:2;stroke-linecap:round;"><path d="M7 17 17 7M8.6 7H17v8.4"/></svg></span>
            </span>
          </a>
        {% endif %}
      </div>

      <!-- RIGHT: platform card stack -->
      <div class="plat-illo" data-reveal="up" style="--d:.1s">
        <div class="plat-stack">
          {% for p in _platforms %}
            <div class="pc">
              <div class="pc-head">
                <div class="pc-avatar" aria-hidden="true"></div>
                <div class="pc-icon" aria-hidden="true">
                  {% set _icon = p.icon | default('') %}
                  {% if _icon == 'facebook' %}
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path></svg>
                  {% elseif _icon == 'tiktok' %}
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.1V9.01a6.33 6.33 0 0 0-.79-.05 6.34 6.34 0 0 0-6.34 6.34 6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.33-6.34V8.69a8.18 8.18 0 0 0 4.78 1.52V6.74a4.85 4.85 0 0 1-1.01-.05z"></path></svg>
                  {% elseif _icon == 'instagram' %}
                    <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" fill="none" stroke="#fff" stroke-width="1.5"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5" stroke="#fff" stroke-width="2" stroke-linecap="round"></line></svg>
                  {% elseif _icon == 'youtube' %}
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.95-1.96C18.88 4 12 4 12 4s-6.88 0-8.59.46A2.78 2.78 0 0 0 1.46 6.42 29 29 0 0 0 1 12a29 29 0 0 0 .46 5.58 2.78 2.78 0 0 0 1.95 1.96C5.12 20 12 20 12 20s6.88 0 8.59-.46a2.78 2.78 0 0 0 1.95-1.96A29 29 0 0 0 23 12a29 29 0 0 0-.46-5.58z"></path><polygon points="9.75 15.02 15.5 12 9.75 8.98 9.75 15.02" fill="#FF0000"></polygon></svg>
                  {% else %}
                    <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="23 7 16 12 23 17 23 7"></polygon><rect x="1" y="5" width="15" height="14" rx="2" ry="2"></rect></svg>
                  {% endif %}
                </div>
              </div>
              <div class="pc-bars"><div class="pc-bar"></div><div class="pc-bar"></div></div>
              <div class="pc-label">{{ p.name | default('') }}</div>
            </div>
          {% endfor %}
        </div>
      </div>

    </div>
  </div>
</section>
