<nav aria-label="Project navigation" class="flex items-center justify-between flex-wrap gap-6 pt-10 border-t border-line">
  <a href="{{ backUrl | default('#') }}" class="inline-flex items-center gap-2 text-sm text-muted hover:text-brand transition-colors font-sans group">
    <svg class="ico transition-transform group-hover:-translate-x-1" viewBox="0 0 24 24" aria-hidden="true"><path d="M19 12H5M10 7l-5 5 5 5" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"></path></svg>
    {{ backLabel | default('Back') }}
  </a>
  {% if nextUrl | default('') or nextLabel | default('') %}
    <a href="{{ nextUrl | default('#') }}" class="next-link">
      {{ nextLabel | default('Next Project') }}
      <span class="next-link-arrow" aria-hidden="true">
        <svg class="ico" aria-hidden="true"><use href="#i-arrow-tr"></use></svg>
      </span>
    </a>
  {% endif %}
</nav>
