{% set _placeholder = theme.link ~ '/assets/images/placeholder.webp' %}
{% if images | default([]) | length %}
  <div class="mb-20" data-reveal="up">
    {% if label | default('') %}
      <div class="section-label mb-6">{{ label }}</div>
    {% endif %}
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 md:gap-6">
      {% for img in images %}
        {% set _src = img.url | default(_placeholder) %}
        <div class="img-placeholder">
          <picture>
            <source srcset="{{ _src }}" type="image/webp">
            <img
              src="{{ _src }}"
              alt="{{ img.alt | default('') }}"
              width="800"
              height="600"
              loading="lazy"
              decoding="async"
              class="w-full h-full object-cover">
          </picture>
        </div>
      {% endfor %}
    </div>
  </div>
{% endif %}
