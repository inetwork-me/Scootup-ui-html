{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "scootup/project-card",
  "title": "Project Card",
  "category": "design",
  "icon": "format-image",
  "description": "A linked project card with thumbnail, title and excerpt.",
  "keywords": [
    "scootup",
    "project",
    "card"
  ],
  "textdomain": "scootup",
  "supports": {
    "html": false
  },
  "attributes": {
    "imageUrl": {
      "type": "string",
      "default": ""
    },
    "imageAlt": {
      "type": "string",
      "default": ""
    },
    "title": {
      "type": "string",
      "default": ""
    },
    "excerpt": {
      "type": "string",
      "default": ""
    },
    "url": {
      "type": "string",
      "default": ""
    }
  },
  "editorScript": "file:../../dist/blocks/project-card/index.js",
  "render": "file:./render.php"
}
